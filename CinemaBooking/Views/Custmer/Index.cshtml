@model IEnumerable<CinemaBooking.Models.Movie>

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Home";
}


<!-- HERO -->

<section class="bg-dark text-white py-5">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <h1 class="display-4 fw-bold">
                    Your Movie Night Starts Here 🎬
                </h1>

                <p class="lead text-light">

                    Discover the latest movies and book
                    your cinema tickets easily.

                </p>

                <a asp-action="Movies"
                   class="btn btn-primary btn-lg">

                    Browse Movies

                </a>

            </div>


            <div class="col-lg-5 text-center">

                <i class="fas fa-film"
                   style="font-size:180px;">
                </i>

            </div>

        </div>

    </div>

</section>


<!-- MOVIES -->

<section class="py-5">

    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2>
                Now Showing
            </h2>

            <a asp-action="Movies"
               class="btn btn-outline-primary">

                View All

            </a>

        </div>


        <div class="row g-4">

            @foreach (var movie in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">


                        @if (!string.IsNullOrEmpty(movie.MainImg))
                        {
                            <img src="@movie.MainImg"
                                 class="card-img-top"
                                 style="height:300px; object-fit:cover;"
                                 alt="@movie.Name">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex
                                align-items-center justify-content-center"
                                 style="height:300px;">

                                <i class="fas fa-film fa-4x"></i>

                            </div>
                        }


                        <div class="card-body">

                            <h5 class="card-title">
                                @movie.Name
                            </h5>

                            <p class="text-muted mb-2">

                                <i class="fas fa-tag me-1"></i>

                                @movie.Category?.Name

                            </p>


                            <p class="text-muted">

                                <i class="fas fa-building me-1"></i>

                                @movie.Cinema?.Name

                            </p>


                            <div class="d-flex justify-content-between
                                align-items-center">

                                <strong>
                                    @movie.Price.ToString("0.00") EGP
                                </strong>

                                <a asp-action="Details"
                                   asp-route-id="@movie.Id"
                                   class="btn btn-primary">

                                    Book Now

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>
